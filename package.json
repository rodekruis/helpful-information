{
  "name": "helpful-information",
  "homepage": "https://helpfulinformation.redcross.nl/",
  "scripts": {
    "prepare": "husky",
    "setup": "cp -i .env.example .env && npm run prepare",
    "start": "ng serve",
    "set-env-variables": "node ./scripts/set-env-variables.mjs",
    "fix-output-path": "node ./scripts/fix-output-path.mjs",
    "build:404-router": "cp www/index.html www/404.html",
    "update-search-index": "node ./scripts/update-search-index.mjs",
    "prebuild": "npm run set-env-variables",
    "build": "ng build",
    "build:production": "npm run build -- --configuration=production",
    "postbuild:production": "npm run fix-output-path && npm run build:404-router",
    "build:e2e": "npm run build:production -- --configuration=test",
    "serve:production": "npx http-server ./www/ -c-1 --port=8080",
    "start:production": "npm run build:production && npm run serve:production",
    "pretest": "npm run lint",
    "test": "ng test --configuration=ci",
    "test:watch": "ng test --configuration=development",
    "setup:e2e": "playwright install --with-deps --no-shell chromium",
    "test:e2e": "playwright test",
    "serve:local-data": "npx http-server ./data/ --port=3003 --cors='*' -i=false -c=-1 --ext=json",
    "upgrade:angular": "ng update @angular/core @angular/cli @angular-eslint/schematics --create-commits",
    "lint": "npm run lint:syntax && npm run lint:typecheck && npm run lint:code && npm run lint:e2e",
    "lint:code": "ng lint",
    "lint:e2e": "tsc --noEmit --project e2e && eslint --env node e2e/**/*.mjs",
    "lint:syntax": "prettier --check \"**/*.{md,yml,json,scss}\"",
    "lint:typecheck": "npx tsc --noEmit",
    "fix:code": "npm run lint:code -- --fix",
    "fix:e2e": "npm run lint:e2e -- --fix",
    "fix:syntax": "npm run lint:syntax -- --write",
    "fix": "npm run fix:code && npm run fix:e2e && npm run fix:syntax"
  },
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/common": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "@ionic/angular": "^8.8.13",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "es-toolkit": "^1.49.0",
    "marked": "^18.0.5",
    "ngx-markdown": "^21.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "ufo": "^1.6.4",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/language-service": "^21.2.17",
    "@ionic/angular-toolkit": "^12.3.0",
    "@microsoft/applicationinsights-debugplugin-js": "^3.4.3",
    "@playwright/test": "^1.62.0",
    "@types/eslint": "^8.56.12",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "baseline-browser-mapping": "^2.11.7",
    "confusing-browser-globals": "^1.0.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "http-server": "^14.1.0",
    "husky": "^9.1.7",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-spec-reporter": "^0.0.36",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{md,yml,json,scss}": "prettier --write",
    "*.{js,mjs,ts,html}": "eslint --fix"
  }
}
